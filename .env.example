# Core runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# Database
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOSTNAME.REGION-postgres.render.com/DATABASE_NAME?sslmode=require"

# CORS
# Comma-separated list. Leave empty only if you intentionally want open CORS.
CORS_ORIGIN="https://your-frontend.example.com"

# MQTT ingestion
# Enable this in production when the broker is available.
ENABLE_MQTT=true
MQTT_BROKER_URL="mqtt://206.189.199.186:1883"
MQTT_CLIENT_ID="memco-backend-01"
MQTT_TOPIC="machine/data/#"
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_KEEPALIVE_SECONDS=60
MQTT_SUBSCRIBE_QOS=1
MQTT_USERNAME=""
MQTT_PASSWORD=""

# Virtual MEMCO Welding Machine Simulator
# Publishes realistic machine JSON to the existing MQTT topics:
# machine/data/<machineCode>
ENABLE_VIRTUAL_MEMCO_SIMULATOR=false
VIRTUAL_MEMCO_MACHINE_CODES="WM-001,WM-002,WM-003"
VIRTUAL_MEMCO_INTERVAL_MS=5000
VIRTUAL_MEMCO_PUBLISH_QOS=1
VIRTUAL_MEMCO_CLIENT_ID="memco-virtual-machine-local"
VIRTUAL_MEMCO_SCENARIO="mixed"
VIRTUAL_MEMCO_FAULT_SCENARIO="none"

# Arc event detection
ARC_CURRENT_THRESHOLD=20
ARC_VOLTAGE_THRESHOLD=10
ARC_END_DEBOUNCE_MS=2000
NEW_ELECTRODE_GAP_SECONDS=45

# Demo telemetry generator
ENABLE_DEMO_TELEMETRY=false
DEMO_TELEMETRY_INTERVAL_MS=120000

# Process shutdown
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
