# Core runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# Database
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOSTNAME.REGION-postgres.render.com/DATABASE_NAME?sslmode=require"

# CORS
# Comma-separated list. Leave empty only if you intentionally want open CORS.
CORS_ORIGIN="https://your-frontend.example.com"

# MQTT ingestion
# Enable this in production when the broker is available.
ENABLE_MQTT=true
MQTT_BROKER_URL="mqtt://127.0.0.1:1883"
MQTT_CLIENT_ID="memco-backend-01"
MQTT_TOPIC="machine/data"
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_KEEPALIVE_SECONDS=60
MQTT_SUBSCRIBE_QOS=1
MQTT_USERNAME=""
MQTT_PASSWORD=""

# Demo telemetry generator
ENABLE_DEMO_TELEMETRY=false
DEMO_TELEMETRY_INTERVAL_MS=120000

# Process shutdown
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
